<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:ViviTune.Ui"
        x:Class="ViviTune.Ui.MainWindow"
        x:DataType="ui:ViewState"
        Title="ViviTune · Sakura"
        Icon="/Assets/icon.ico"
        Width="1000" Height="640"
        MinWidth="760" MinHeight="520"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="fonts:Inter#Inter">
  <Grid ColumnDefinitions="154,*">
    <Border Background="{StaticResource MenuBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="8" Margin="0,22,0,0" HorizontalAlignment="Center">
        <StackPanel Margin="12,0,0,20" Spacing="4">
          <TextBlock Text="ViviTune" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Accent1Brush}" />
          <TextBlock Text="SAKURA EDITION" FontSize="9" LetterSpacing="2" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
        <RadioButton Name="NavHome" Theme="{StaticResource NavItem}" GroupName="nav" IsChecked="True" ToolTip.Tip="Главная">
          <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Width="20" Height="20" Data="M12 3 2 12h3v8h5v-6h4v6h5v-8h3z" />
                    <TextBlock Text="Главная" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Name="NavApps" Theme="{StaticResource NavItem}" GroupName="nav" ToolTip.Tip="Приложения">
          <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Width="18" Height="18" Data="M3 3h8v8H3z M13 3h8v8h-8z M3 13h8v8H3z M13 13h8v8h-8z" />
                    <TextBlock Text="Приложения" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Name="NavLog" Theme="{StaticResource NavItem}" GroupName="nav" ToolTip.Tip="Лог">
          <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Width="18" Height="18" Data="M3 5h18v2.5H3z M3 10.75h18v2.5H3z M3 16.5h12v2.5H3z" />
                    <TextBlock Text="Лог" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
        <RadioButton Name="NavSettings" Theme="{StaticResource NavItem}" GroupName="nav" ToolTip.Tip="Настройки">
          <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Width="20" Height="20"
                    Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41L9.25 5.35c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" />
                    <TextBlock Text="Настройки" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
      <!-- Декоративный маскот не перехватывает мышь и не участвует в Tab-навигации. -->
      <Border Grid.Row="1" Margin="6,14,6,0" CornerRadius="18" ClipToBounds="True" VerticalAlignment="Bottom"
              IsHitTestVisible="False">
        <Panel MaxHeight="248">
          <Image Source="/Assets/sakura-mascot.png" Stretch="Uniform" IsVisible="{Binding MascotClassic}"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <Image Source="/Assets/sakura-casual.png" Stretch="Uniform" IsVisible="{Binding MascotCasual}"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <Image Source="/Assets/sakura-summer.png" Stretch="Uniform" IsVisible="{Binding MascotSummer}"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Panel>
      </Border>
      <StackPanel Grid.Row="2" Margin="12,10,12,14" Spacing="5"
                  ToolTip.Tip="Загрузка + отдача через прокси/VPN за сеанс. Образы меняются на 1 и 10 ГБ (1024³ байт в ГБ). Новое подключение сбрасывает прогресс; внутренний перезапуск сохраняет его.">
        <TextBlock Text="{Binding MascotStageText}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource Accent1Brush}" />
        <TextBlock Text="{Binding MascotTrafficText}" FontSize="10" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding MascotProgress}" Height="4" MinHeight="4" MinWidth="0" MaxWidth="130"
                     Foreground="{StaticResource AccentGradient}" Background="{StaticResource LineBrush}"
                     AutomationProperties.Name="Прогресс до следующего образа Vivi" />
        <TextBlock Text="{Binding MascotNextText}" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
      </Grid>
    </Border>
    <Panel Grid.Column="1">
      <Border IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#261b30" />
            <GradientStop Offset="0.55" Color="#19131f" />
            <GradientStop Offset="1" Color="#211729" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <ui:HomePage IsVisible="{Binding #NavHome.IsChecked}" />
      <ui:AppsPage IsVisible="{Binding #NavApps.IsChecked}" />
      <ui:LogPage IsVisible="{Binding #NavLog.IsChecked}" />
      <ui:SettingsPage IsVisible="{Binding #NavSettings.IsChecked}" />
    </Panel>
  </Grid>
</Window>
