<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Sakura: общая палитра всех страниц и состояний. -->
      <SolidColorBrush x:Key="BgBrush" Color="#19131f" />
      <SolidColorBrush x:Key="MenuBrush" Color="#130e19" />
      <SolidColorBrush x:Key="CardBrush" Color="#251c2e" />
      <SolidColorBrush x:Key="LineBrush" Color="#44304f" />
      <SolidColorBrush x:Key="TextBrush" Color="#fff1fa" />
      <SolidColorBrush x:Key="MutedBrush" Color="#bfa8ca" />
      <SolidColorBrush x:Key="Accent1Brush" Color="#f6a2cb" />
      <SolidColorBrush x:Key="Accent2Brush" Color="#bd9bfa" />
      <SolidColorBrush x:Key="OkBrush" Color="#8bdfbe" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#ff8fa3" />
      <SolidColorBrush x:Key="WarnBrush" Color="#f5cd87" />
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#f6a2cb" />
        <GradientStop Offset="1" Color="#bd9bfa" />
      </LinearGradientBrush>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

      <!-- Шрифт и поля ввода Fluent под палитру -->
      <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter</FontFamily>
      <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
      <SolidColorBrush x:Key="TextControlBackground" Color="#19131f" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#19131f" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#19131f" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#211928" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#44304f" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#795174" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#f6a2cb" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#36263f" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#fff1fa" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#fff1fa" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#fff1fa" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#bfa8ca" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#bfa8ca" />

      <!-- Пункт бокового меню: значок, активный — акцент 1 -->
      <ControlTheme x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Width" Value="134" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          <Setter Property="Background" Value="#2b1e34" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{StaticResource Accent1Brush}" />
          <Setter Property="Background" Value="#26f6a2cb" />
        </Style>
      </ControlTheme>

      <!-- Переключатель вкл/выкл (строки приложений): выкл — серый, вкл — градиент -->
      <ControlTheme x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="#583c61" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" CornerRadius="9">
              <Ellipse Name="Knob" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left" Fill="#bfa8ca" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Knob">
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="Fill" Value="White" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Карточка -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Тексты -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Вкладка сегмента: выбранная — фон LineBrush и светлый текст -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.tab:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.tab.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tab.warn.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
  </Style>

  <!-- Главная кнопка («＋ Добавить»): градиент акцент 1 → акцент 2.
       Не класс accent: у Fluent есть свой Button.accent, он перекрывает фон шаблона. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#130e19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#130e19" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#130e19" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Плоская кнопка-значок («✕» у приложения) -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#44304f" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#583c61" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <!-- Клавиатурный фокус виден и в собственных шаблонах. -->
  <Style Selector="RadioButton:focus-visible /template/ Border">
    <Setter Property="BorderBrush" Value="{StaticResource Accent1Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton:focus-visible /template/ Border">
    <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
</Styles>
